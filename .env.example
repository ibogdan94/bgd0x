# Copy to .env and fill in. Secrets never get committed (.env is gitignored).

# --- X / Twitter OAuth 2.0 (from developer.x.com, app = Read and Write) ---
ClientId=
ClientSecret=
# User tokens (generated via OAuth2). Auto-refreshed at runtime.
AccessToken=
RefreshToken=

# --- Posting schedule (US Eastern by default) ---
POST_TZ=America/New_York
WINDOW_START=8
WINDOW_END=22

# --- Content / referral ---
EXCHANGE=WhiteBIT
REF_LINK=https://whitebit.com/referral/xxxxxxxx
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Dashboard login ---
DASH_EMAIL=you@example.com
DASH_PASSWORD=
AUTH_SECRET=

# --- State backend ---
# Leave STATE_TABLE blank for local files; set to the DynamoDB table on AWS.
STATE_TABLE=
AWS_REGION=us-east-1
