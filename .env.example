# Copy to .env and fill in. Secrets never get committed (.env is gitignored).

# --- X / Twitter OAuth 2.0 (from developer.x.com, app = Read and Write) ---
ClientId=
ClientSecret=
# User tokens (generated via OAuth2). Auto-refreshed at runtime.
AccessToken=
RefreshToken=

# --- Posting schedule (US Eastern by default) ---
# Tweets per day: a random count in [min, max] placed randomly inside the window.
POSTS_PER_DAY_MIN=5
POSTS_PER_DAY_MAX=6
# Minimum minutes between two posts.
MIN_GAP_MINUTES=40
POST_TZ=America/New_York
WINDOW_START=8
WINDOW_END=22

# --- Content / referral ---
EXCHANGE=WhiteBIT
REF_LINK=https://whitebit.com/referral/xxxxxxxx
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Dashboard login ---
DASH_EMAIL=you@example.com
DASH_PASSWORD=
AUTH_SECRET=

# --- Video pipeline (Black Forest Labs, bfl.ai — FLUX 3 image-to-video) ---
# API key from bfl.ai. Requires credits for real renders.
BFL=
# Max videos auto-posted per day.
VIDEO_DAILY_MAX=2

# --- State backend ---
# Leave STATE_TABLE blank for local files; set to the DynamoDB table on AWS.
STATE_TABLE=
AWS_REGION=us-east-1
# S3 bucket for uploaded source images (cloud video pipeline). Blank = local ./media folder.
MEDIA_BUCKET=
