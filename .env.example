# Twitter / X API credentials (from developer.x.com)
# App auth settings must be set to "Read and Write"

ConsumerKey=your_api_key
SecretKey=your_api_secret
BearerToken=your_bearer_token          # app-only, read-only (not used for posting)

# Required to POST tweets (OAuth 1.0a user context) — generate in the portal:
AccessToken=your_access_token
AccessTokenSecret=your_access_token_secret
